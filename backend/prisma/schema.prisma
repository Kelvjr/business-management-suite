generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}

enum SaleType {
  PRODUCT
  SERVICE
  PACKAGE
  CUSTOM
}

enum PricingMethod {
  FIXED
  PER_ITEM
  BY_WEIGHT
  BY_VOLUME
  PER_HOUR
  PER_DAY
  PER_PERSON
  CUSTOM_UNIT
}

enum DiscountType {
  NONE
  FIXED
  PERCENTAGE
}

enum PaymentStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum PaymentDirection {
  IN
  OUT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
}

model Sale {
  id                  String        @id @default(cuid())
  reference           String        @unique
  customerName        String?
  description         String
  category            String
  amount              Decimal       @db.Decimal(12, 2)
  paymentMethod       PaymentMethod
  type                SaleType      @default(CUSTOM)
  pricingMethod       PricingMethod @default(FIXED)
  measurement         Decimal?      @db.Decimal(12, 3)
  unit                String?
  rate                Decimal?      @db.Decimal(12, 2)
  subtotal            Decimal       @default(0) @db.Decimal(12, 2)
  discountType        DiscountType  @default(NONE)
  discountValue       Decimal       @default(0) @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  taxRate             Decimal       @default(0) @db.Decimal(6, 3)
  taxAmount           Decimal       @default(0) @db.Decimal(12, 2)
  manualTotalOverride Boolean       @default(false)
  paymentStatus       PaymentStatus @default(PAID)
  amountPaid          Decimal       @default(0) @db.Decimal(12, 2)
  balanceDue          Decimal       @default(0) @db.Decimal(12, 2)
  customFields        Json          @default("{}")
  customerId          String?
  soldAt              DateTime      @default(now())
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  customer    Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items       SaleItem[]
  attachments SaleAttachment[]
  activity    SaleActivity[]
  payments    Payment[]

  @@index([soldAt])
  @@index([customerName])
  @@index([category])
  @@index([customerId])
}

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  birthday  DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sales     Sale[]
  invoices  Invoice[]
  payments  Payment[]

  @@index([name])
}

model SaleItem {
  id                  String        @id @default(cuid())
  saleId              String
  name                String
  type                SaleType
  pricingMethod       PricingMethod
  measurement         Decimal?      @db.Decimal(12, 3)
  unit                String?
  rate                Decimal       @db.Decimal(12, 2)
  lineTotal           Decimal       @db.Decimal(12, 2)
  manualTotalOverride Boolean       @default(false)
  sortOrder           Int           @default(0)
  catalogItemId       String?
  sale                Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  catalogItem         CatalogItem?  @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([catalogItemId])
}

enum CatalogKind {
  PRODUCT
  SERVICE
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  TRANSFER
}

enum StorageVisibility {
  PUBLIC
  PRIVATE
}

model CatalogItem {
  id              String              @id @default(cuid())
  kind            CatalogKind
  name            String
  sku             String?             @unique
  category        String
  costPrice       Decimal             @default(0) @db.Decimal(12, 2)
  sellingPrice    Decimal             @db.Decimal(12, 2)
  quantity        Decimal             @default(0) @db.Decimal(12, 3)
  reorderLevel    Decimal             @default(0) @db.Decimal(12, 3)
  barcode         String?             @unique
  imageUrl        String?
  durationMinutes Int?
  assignedStaff   String?
  active          Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  saleItems       SaleItem[]
  movements       InventoryMovement[]
  supplierLinks   SupplierProduct[]
  purchaseItems   PurchaseItem[]
  images          ProductImage[]

  @@index([kind, category])
  @@index([name])
}

model ProductImage {
  id            String            @id @default(cuid())
  catalogItemId String
  bucket        String
  storageKey    String
  originalName  String
  mimeType      String
  size          Int
  visibility    StorageVisibility @default(PUBLIC)
  isPrimary     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  catalogItem   CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@unique([bucket, storageKey])
  @@index([catalogItemId, isPrimary])
}

model InventoryMovement {
  id            String            @id @default(cuid())
  catalogItemId String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  beforeQty     Decimal           @db.Decimal(12, 3)
  afterQty      Decimal           @db.Decimal(12, 3)
  reference     String?
  notes         String?
  createdAt     DateTime          @default(now())
  catalogItem   CatalogItem       @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@index([catalogItemId, createdAt])
}

model Supplier {
  id           String            @id @default(cuid())
  name         String
  contactName  String?
  phone        String?
  email        String?
  address      String?
  paymentTerms String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  products     SupplierProduct[]
  purchases    Purchase[]
  payments     Payment[]

  @@index([name])
}

model SupplierProduct {
  supplierId    String
  catalogItemId String
  supplier      Supplier    @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@id([supplierId, catalogItemId])
}

model Purchase {
  id         String         @id @default(cuid())
  reference  String         @unique
  supplierId String
  status     PurchaseStatus @default(DRAFT)
  total      Decimal        @default(0) @db.Decimal(12, 2)
  amountPaid Decimal        @default(0) @db.Decimal(12, 2)
  orderedAt  DateTime       @default(now())
  receivedAt DateTime?
  dueAt      DateTime?
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  items      PurchaseItem[]
  payments   Payment[]

  @@index([supplierId, orderedAt])
}

model PurchaseItem {
  id            String      @id @default(cuid())
  purchaseId    String
  catalogItemId String
  quantity      Decimal     @db.Decimal(12, 3)
  unitCost      Decimal     @db.Decimal(12, 2)
  receivedQty   Decimal     @default(0) @db.Decimal(12, 3)
  purchase      Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  catalogItem   CatalogItem @relation(fields: [catalogItemId], references: [id])

  @@index([purchaseId])
}

model Invoice {
  id           String        @id @default(cuid())
  reference    String        @unique
  customerId   String?
  customerName String
  status       PaymentStatus @default(UNPAID)
  subtotal     Decimal       @db.Decimal(12, 2)
  taxAmount    Decimal       @default(0) @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  amountPaid   Decimal       @default(0) @db.Decimal(12, 2)
  issuedAt     DateTime      @default(now())
  dueAt        DateTime
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@index([status, dueAt])
}

model Payment {
  id         String           @id @default(cuid())
  amount     Decimal          @db.Decimal(12, 2)
  method     PaymentMethod
  direction  PaymentDirection
  paidAt     DateTime         @default(now())
  reference  String?
  notes      String?
  customerId String?
  supplierId String?
  invoiceId  String?
  saleId     String?
  purchaseId String?
  createdAt  DateTime         @default(now())
  customer   Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoice    Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  sale       Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  purchase   Purchase?        @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([paidAt])
  @@index([direction, paidAt])
  @@index([customerId, paidAt])
  @@index([supplierId, paidAt])
  @@index([invoiceId, paidAt])
  @@index([saleId, paidAt])
  @@index([purchaseId, paidAt])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  rate        Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model SaleAttachment {
  id           String            @id @default(cuid())
  saleId       String
  bucket       String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  visibility   StorageVisibility @default(PRIVATE)
  createdAt    DateTime          @default(now())
  sale         Sale              @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@unique([saleId, bucket, storageKey])
}

model SaleActivity {
  id        String   @id @default(cuid())
  saleId    String
  action    String
  summary   String
  changes   Json?
  createdAt DateTime @default(now())
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId, createdAt])
}

model Expense {
  id            String              @id @default(cuid())
  reference     String              @unique
  vendor        String?
  description   String
  category      String
  amount        Decimal             @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus       @default(PAID)
  amountPaid    Decimal             @default(0) @db.Decimal(12, 2)
  balanceDue    Decimal             @default(0) @db.Decimal(12, 2)
  incurredAt    DateTime            @default(now())
  notes         String?
  customFields  Json                @default("{}")
  isRecurring   Boolean             @default(false)
  recurrence    String?
  nextDueAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  attachments   ExpenseAttachment[]
  activity      ExpenseActivity[]

  @@index([incurredAt])
  @@index([vendor])
  @@index([category])
  @@index([isRecurring, nextDueAt])
}

model ExpenseAttachment {
  id           String            @id @default(cuid())
  expenseId    String
  bucket       String
  storageKey   String
  originalName String
  mimeType     String
  size         Int
  visibility   StorageVisibility @default(PRIVATE)
  createdAt    DateTime          @default(now())
  expense      Expense           @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId])
  @@unique([expenseId, bucket, storageKey])
}

model ExpenseActivity {
  id        String   @id @default(cuid())
  expenseId String
  action    String
  summary   String
  changes   Json?
  createdAt DateTime @default(now())
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  @@index([expenseId, createdAt])
}

model BusinessSettings {
  id                String   @id @default("primary")
  businessName      String   @default("Renaissance Studio")
  currency          String   @default("USD")
  timezone          String   @default("UTC")
  weekStartsOn      Int      @default(1)
  emailReports      Boolean  @default(true)
  saleNotifications Boolean  @default(true)
  salesCustomFields Json     @default("[]")
  updatedAt         DateTime @updatedAt
}
