generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Sale {
  id            String         @id @default(cuid())
  businessId    String         @default("default-business")
  customerId    String?
  itemType      String
  itemName      String
  category      String?
  subcategory   String?
  quantity      Int            @default(1)
  unitPrice     Decimal        @db.Decimal(10, 2)
  totalAmount   Decimal        @db.Decimal(10, 2)
  paymentMethod String?
  paymentStatus String         @default("paid")
  salesChannel  String?
  customerName  String?
  notes         String?
  soldAt        DateTime       @default(now())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  business      Business       @relation(fields: [businessId], references: [id])
  customer      Customer?      @relation(fields: [customerId], references: [id])
  lineItems     SaleLineItem[]
  invoices      Invoice[]
  receipts      Receipt[]

  @@index([businessId, soldAt])
  @@index([customerId])
}

model Category {
  id          String   @id @default(cuid())
  businessId  String   @default("default-business")
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, name])
  @@index([businessId])
}

model Customer {
  id           String    @id @default(cuid())
  businessId   String    @default("default-business")
  name         String
  email        String?
  phone        String?
  businessName String?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  business     Business  @relation(fields: [businessId], references: [id])
  sales        Sale[]
  invoices     Invoice[]

  @@unique([businessId, email])
  @@index([businessId])
}

model Business {
  id          String           @id @default(cuid())
  name        String
  ownerEmail  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       InternalUser[]
  sales       Sale[]
  categories  Category[]
  customers   Customer[]
  expenses    Expense[]
  invoices    Invoice[]
  receipts    Receipt[]
  snapshots   ProfitSnapshot[]
}

model InternalUser {
  id         String   @id @default(cuid())
  businessId String
  name       String
  email      String?  @unique
  role       String   @default("owner")
  isAdmin    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  business   Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
}

model SaleLineItem {
  id          String   @id @default(cuid())
  saleId      String
  itemType    String
  itemName    String
  category    String?
  subcategory String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  totalAmount Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

model Expense {
  id        String   @id @default(cuid())
  businessId String  @default("default-business")
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  date      DateTime @default(now())
  vendor    String?
  notes     String?
  recurring Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business  Business @relation(fields: [businessId], references: [id])

  @@index([businessId, date])
  @@index([businessId, category])
}

model Invoice {
  id            String    @id @default(cuid())
  businessId    String    @default("default-business")
  invoiceNumber String    @unique
  saleId        String?
  customerId    String?
  customerName  String?
  customerEmail String?
  customerPhone String?
  lineItems     Json
  subtotal      Decimal   @db.Decimal(10, 2)
  tax           Decimal   @default(0) @db.Decimal(10, 2)
  discount      Decimal   @default(0) @db.Decimal(10, 2)
  total         Decimal   @db.Decimal(10, 2)
  paymentStatus String    @default("pending")
  notes         String?
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  business      Business  @relation(fields: [businessId], references: [id])
  sale          Sale?     @relation(fields: [saleId], references: [id])
  customer      Customer? @relation(fields: [customerId], references: [id])

  @@index([businessId, createdAt])
  @@index([saleId])
  @@index([customerId])
}

model Receipt {
  id            String   @id @default(cuid())
  businessId    String   @default("default-business")
  saleId        String
  receiptNumber String   @unique
  generatedAt   DateTime @default(now())
  amount        Decimal  @db.Decimal(10, 2)
  paymentStatus String
  paymentMethod String?
  business      Business @relation(fields: [businessId], references: [id])
  sale          Sale     @relation(fields: [saleId], references: [id])

  @@index([businessId, generatedAt])
  @@index([saleId])
}

model ProfitSnapshot {
  id         String   @id @default(cuid())
  businessId String   @default("default-business")
  date       DateTime
  revenue    Decimal  @db.Decimal(10, 2)
  expenses   Decimal  @db.Decimal(10, 2)
  profit     Decimal  @db.Decimal(10, 2)
  margin     Decimal  @db.Decimal(7, 2)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, date])
  @@index([businessId, date])
}
